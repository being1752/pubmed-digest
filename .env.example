# 必填
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 必填（NCBI 要求提供联系邮箱，任意邮箱即可，无需注册）
PUBMED_EMAIL=your_email@example.com

# 可选：DeepSeek 接口地址与模型（有默认值）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 可选：PubMed API Key（免费申请，可提升请求频率上限至 10 次/秒）
# 申请地址：https://www.ncbi.nlm.nih.gov/account/
# PUBMED_API_KEY=your_pubmed_api_key_here

# 可选：解说词输出目录（默认 ./output）
OUTPUT_DIR=./output

# 可选：每次从 PubMed 最多抓取的论文篇数，默认 30
# PUBMED_MAX_RESULTS=30

# 可选：生成哪些平台的 AITDA 脚本（all 或逗号分隔列表：douyin,shipinghao,xiaohongshu），默认 all
# PLATFORMS=all

# 可选：各平台 AITDA 脚本总字数（AITDA 各段按比例自动计算：钩子10%/兴趣25%/信任31%/欲望25%/行动~9%）
# DOUYIN_WORDS=240
# SHIPINGHAO_WORDS=300
# XIAOHONGSHU_WORDS=210

# ── 商业赛道模式（多平台，字数复用上方各平台配置）──────────────────────────────
# 内容模式：health（默认健康科普）或 business（商业赛道·投资视角）
# CONTENT_MODE=health
